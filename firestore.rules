rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'richard.graczer@gmail.com';
    }

    function validTask(data) {
      return data.keys().hasAll(['text', 'created_at', 'done', 'priority', 'category'])
        && data.keys().hasOnly(['text', 'created_at', 'done', 'priority', 'category'])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 200
        && data.created_at is string
        && data.done is bool
        && data.priority is string
        && data.priority in ['low', 'medium', 'high']
        && data.category is string
        && data.category.size() <= 30;
    }

    match /tasks/{taskId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validTask(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
